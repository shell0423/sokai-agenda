<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- ジョブの識別子（一意の名前）-->
    <key>Label</key>
    <string>com.sokai.refresh</string>

    <!-- 実行するコマンド: プロジェクト直下に cd してから publish.py を回す。
         launchd の CWD 既定は "/"（読み取り専用）で EROFS になるため必ず明示。

         「fast」オプション = src.jobs fast のみ（数秒〜1分）。株価/PER/PBR を倉庫から
         取り直し、実戦リストと docs/index.html を作り直して push する。
         総会データ(EDINET)の再スキャンは年1回の季節作業なので日次では回さない
         （総会後は手動で `.venv/bin/python scripts/publish.py`＝フル更新）。

         ⚠ XML コメント内に連続ハイフンを書かないこと。plutil と launchd は通すが
            Python の expat が not well-formed で落ちる（このファイルで実際に起きていた）。

         ⚠ 絶対パス（/Users/<ユーザー名>/…）を書かないこと。このリポジトリは
            GitHub で公開されているため、書くと macOS のユーザー名が露出する。
            zsh の -lc 経由なら ~ が展開される（plist 自体は展開しない）。
            ログも StandardOutPath ではなくシェル内でリダイレクトする
            （StandardOutPath は ~ を展開しないため）。 -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-lc</string>
        <string>cd ~/Claude/株主総会議案分析 &amp;&amp; mkdir -p output/logs &amp;&amp; .venv/bin/python scripts/publish.py --fast &gt;&gt; output/logs/launchd_stdout.log 2&gt;&gt; output/logs/launchd_stderr.log</string>
    </array>

    <!-- 毎日 06:00 JST に実行（総会シーズンの臨時報告書を翌朝反映） -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- ロード直後は走らせない（RunAtLoad=false）。手動テストは launchctl kickstart で -->
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
