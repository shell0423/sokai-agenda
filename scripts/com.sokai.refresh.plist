<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- ジョブの識別子（一意の名前）-->
    <key>Label</key>
    <string>com.sokai.refresh</string>

    <!-- 実行するコマンド: プロジェクト直下に cd してから publish.py を回す。
         launchd の CWD 既定は "/"（読み取り専用）で EROFS になるため必ず明示。 -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>cd /Users/nikihiroki/Claude/株主総会議案分析 &amp;&amp; .venv/bin/python scripts/publish.py</string>
    </array>

    <!-- 作業ディレクトリを明示 -->
    <key>WorkingDirectory</key>
    <string>/Users/nikihiroki/Claude/株主総会議案分析</string>

    <!-- 毎日 06:00 JST に実行（総会シーズンの臨時報告書を翌朝反映） -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- ロード直後は走らせない（RunAtLoad=false）。手動テストは launchctl kickstart で -->
    <key>RunAtLoad</key>
    <false/>

    <!-- 標準出力・エラー出力のログファイル -->
    <key>StandardOutPath</key>
    <string>/Users/nikihiroki/Claude/株主総会議案分析/output/logs/launchd_stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/nikihiroki/Claude/株主総会議案分析/output/logs/launchd_stderr.log</string>
</dict>
</plist>
