# -----------------------------------------------------------------------------
# Streamlit Community Cloud 用の Secrets テンプレート
# -----------------------------------------------------------------------------
# このファイルは「見本」です。実キーは絶対にここに書かないでください。
# 実際の運用は次のいずれかで行います。
#
#   [ローカル実行]
#     プロジェクトルートの .env に書く（既存の運用）。
#     このファイル (.streamlit/secrets.toml.example) はコピー不要です。
#
#   [Streamlit Community Cloud 実行]
#     https://share.streamlit.io で対象 app を開き、
#       Settings → Secrets タブ
#     の入力欄に、この見本の中身をコピーして値をあなたの実キーに置換し保存。
#     保存すると Cloud 側で自動再デプロイされます。
#
# ⚠️ .streamlit/secrets.toml（実キー入り）は .gitignore で除外されています。
#    誤って追跡された場合は `git rm --cached .streamlit/secrets.toml` で外してください。
# -----------------------------------------------------------------------------

# EDINET API キー（必須：サイドバーの「フル更新」「充足チェック」で使用）
# 取得: https://disclosure.edinet-fsa.go.jp/ にログインし、API利用登録ページから発行。
EDINET_API_KEY = "your_edinet_api_key_here"

# WAREHOUSE_DIR（任意）
# ~/Claude/warehouse を別パスに置いている場合のみ設定。Cloud では設定しないでください
# （Cloud 環境には warehouse が存在しないため、社名補完・倉庫レディネス判定は自動的にスキップされます）。
# WAREHOUSE_DIR = "/absolute/path/to/warehouse"
